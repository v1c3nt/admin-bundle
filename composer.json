{
    "name": "vvbx/admin-bundle",
    "description": "Socle EasyAdmin commun aux applications de la suite vvbx : aide intégrée (pages Markdown, boutons « Aide » des écrans)",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "easycorp/easyadmin-bundle": "^5.10",
        "league/commonmark": "^2.10",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-bundle": "^7.4",
        "twig/extra-bundle": "^3.29",
        "twig/markdown-extra": "^3.29",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4"
    },
    "suggest": {
        "symfony/browser-kit": "classe de test Vvbx\\AdminBundle\\Testing\\HelpTestCase"
    },
    "autoload": {
        "psr-4": {
            "Vvbx\\AdminBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vvbx\\AdminBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    }
}
